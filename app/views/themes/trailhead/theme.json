{
  "slug": "trailhead",
  "name": "Trailhead",
  "version": "1.0.0",
  "author": "Supremely",
  "description": "An earthy, outdoors-flavored theme \u2014 and the worked example for the theme-building tutorial (docs/themes/building-a-theme.md).",
  "settings": {
    "forest": {
      "type": "color",
      "label": "Forest (accent)",
      "default": "#2d6a4f"
    },
    "bark": {
      "type": "color",
      "label": "Bark (headings)",
      "default": "#40241a"
    }
  },
  "content": {
    "fields": [
      {
        "key": "headline",
        "type": "text",
        "label": "Headline",
        "max": 100,
        "hint": "The big line on your landing page."
      },
      {
        "key": "subhead",
        "type": "textarea",
        "label": "Subheading",
        "max": 240,
        "hint": "One or two sentences under the headline."
      },
      {
        "key": "cta_label",
        "type": "text",
        "label": "Button label",
        "max": 40,
        "default": "Join the community"
      },
      {
        "key": "cta_url",
        "type": "url",
        "label": "Button link",
        "max": 200,
        "default": "/auth/register"
      }
    ]
  }
}
