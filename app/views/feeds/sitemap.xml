{#- Every public address on this site. Built for a crawler, so it holds
    what anybody may read and never what the fetcher in particular may. -#}
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for url in urls %}
  <url>
    <loc>{{ url.loc }}</loc>
    {%- if url.lastmod %}
    <lastmod>{{ url.lastmod|iso_date }}</lastmod>
    {%- endif %}
  </url>
  {%- endfor %}
</urlset>
